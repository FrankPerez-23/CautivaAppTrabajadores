<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cautiva_background"
    tools:device="spec:width=411dp,height=891dp,dpi=420"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedor_principal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Logo en Cabecera -->
        <ImageView
            android:id="@+id/img_logo_cabecera"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo Cautiva"
            android:scaleType="fitStart"
            android:src="@drawable/logo_cautiva"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Mensaje de Bienvenida con nombre del chofer -->
        <TextView
            android:id="@+id/tv_mensaje_bienvenida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/cautiva_text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Bienvenido, Juan Pérez"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_logo_cabecera" />

        <TextView
            android:id="@+id/tv_rol_chofer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chofer / Operador de Concreto"
            android:textColor="@color/cautiva_text_gray"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_mensaje_bienvenida" />

        <!-- Tarjeta de Estado del Turno -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjeta_estado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/cautiva_card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_rol_chofer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Indicador y Textos de Estado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Punto Indicador (Verde / Gris) -->
                    <View
                        android:id="@+id/indicador_punto_estado"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/dot_inactive" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_titulo_estado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cautiva_text_dark"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Fuera de jornada" />

                        <TextView
                            android:id="@+id/tv_subtitulo_estado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/cautiva_text_gray"
                            android:textSize="13sp"
                            tools:text="Presiona el botón para comenzar a transmitir" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#EEEEEE" />

                <!-- Telemetría: Batería y Velocidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Batería -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#F8F9FA">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BATERÍA"
                            android:textColor="@color/cautiva_text_gray"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_nivel_bateria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-- %"
                            android:textColor="@color/cautiva_text_dark"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="12dp"
                        android:layout_height="match_parent" />

                    <!-- Velocidad -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#F8F9FA">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VELOCIDAD"
                            android:textColor="@color/cautiva_text_gray"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_velocidad_actual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.0 km/h"
                            android:textColor="@color/cautiva_text_dark"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Última Sincronización -->
                <TextView
                    android:id="@+id/tv_ultima_sincronizacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/cautiva_text_gray"
                    android:textSize="12sp"
                    tools:text="Última actualización: --" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Principal de Acción -->
        <Button
            android:id="@+id/btn_accion_jornada"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="@color/cautiva_primary_orange"
            android:text="INICIAR JORNADA"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjeta_estado" />

        <!-- ProgressBar de Estado -->
        <ProgressBar
            android:id="@+id/pb_cargando_principal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/cautiva_primary_orange"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_accion_jornada" />

        <!-- Botón Cerrar Sesión -->
        <Button
            android:id="@+id/btn_cerrar_sesion"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Cerrar sesión"
            android:textColor="@color/cautiva_text_gray"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pb_cargando_principal" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
